rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function userEmail() { return request.auth.token.email.lower(); }
    function isAllowed() {
      return isSignedIn() && exists(/databases/$(database)/documents/allowedUsers/$(userEmail()));
    }
    function isSiteAdmin() {
      return isAllowed() && get(/databases/$(database)/documents/allowedUsers/$(userEmail())).data.role == 'admin';
    }

    // Per-feature access inside a group (Settings → Access): admins can always
    // do everything; anyone else has members[uid].access[feature] — 'none',
    // 'view' or 'edit' — where a missing entry means 'edit', so members from
    // before access levels existed keep full use. `feature` is a capability
    // key: expenses, photoSaving, shoppingList, storage.
    function groupMember(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data.members[request.auth.uid];
    }
    function isInGroup(groupId) {
      return isAllowed() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }
    function canView(groupId, feature) {
      return isInGroup(groupId) && (
        groupMember(groupId).role == 'admin'
        || groupMember(groupId).get('access', {}).get(feature, 'edit') != 'none'
      );
    }
    function canEdit(groupId, feature) {
      return isInGroup(groupId) && (
        groupMember(groupId).role == 'admin'
        || groupMember(groupId).get('access', {}).get(feature, 'edit') == 'edit'
      );
    }

    match /allowedUsers/{email} {
      allow read: if isAllowed();
      allow create, update, delete: if isSiteAdmin();
    }

    match /users/{uid} {
      allow read: if isAllowed();
      allow create, update: if isAllowed() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if isAllowed();
      allow create, update, delete: if isAllowed();
    }

    // Published by the bot (Admin SDK, bypasses rules) on every connect —
    // clients only ever read these to populate the admin panel.
    match /whatsappGroups/{jid} {
      allow read: if isAllowed();
      allow write: if false;
    }
    match /botStatus/{statusId} {
      allow read: if isAllowed();
      allow write: if false;
    }

    // Doc id is the app group's own id — managed by that group's admin, read
    // live by the bot (a client update takes effect immediately, no restart).
    match /whatsappIntegrations/{groupId} {
      function isAdminOfGroup() {
        return isAllowed()
          && get(/databases/$(database)/documents/groups/$(groupId)).data.members[request.auth.uid].role == 'admin';
      }
      allow read, write: if isAdminOfGroup();

      match /unmappedSenders/{jid} {
        allow read, write: if isAdminOfGroup();
      }
    }

    // Doc id is the app group's own id, same pattern as whatsappIntegrations
    // above — a group's "Photo saving" capability config. Exposes a raw
    // filesystem path on the bot's machine, so site-admin only rather than
    // any group admin (confirmed: stricter than whatsappIntegrations on
    // purpose, since a group admin isn't necessarily trusted with the host
    // machine's filesystem).
    match /photoSavingConfig/{groupId} {
      allow read, write: if isSiteAdmin();
    }

    // PERSONAL reminders only — a scheduled WhatsApp nudge DMed to whoever
    // it's aimed at. Group-scoped ones live at groups/{groupId}/reminders
    // instead (see below), specifically so their group-membership check can
    // use the group id from the document's PATH rather than a resource.data
    // field: Firestore can only treat a list query as provably safe when any
    // get() calls in the rule resolve from the path/query itself, not from a
    // per-document field value — this collection sidesteps that entirely by
    // never needing a group-membership check. (An earlier version of this
    // rule tried to handle both personal and group reminders in one flat
    // collection branching on resource.data.scope; every list query against
    // it came back permission-denied because of exactly this, even though a
    // single get()-by-id worked fine — which is why it looked fine in an
    // isolated check but broke the app's actual list queries.)
    match /reminders/{reminderId} {
      allow read, update, delete: if isAllowed() && (
        resource.data.ownerUid == request.auth.uid || resource.data.targetUid == request.auth.uid
      );
      allow create: if isAllowed() && request.resource.data.ownerUid == request.auth.uid;
    }

    match /groups/{groupId} {
      // Checks memberUids (not the members map) so this matches the array-contains
      // query the app uses to list "my groups" — Firestore can only verify a query
      // is rule-safe when the rule reads the same field the query filters on.
      function isMember() { return isAllowed() && request.auth.uid in resource.data.memberUids; }
      function isGroupAdmin() { return isAllowed() && resource.data.members[request.auth.uid].role == 'admin'; }

      allow read: if isMember();
      allow create: if isAllowed()
        && request.resource.data.members[request.auth.uid].role == 'admin'
        && request.auth.uid in request.resource.data.memberUids;
      allow update, delete: if isGroupAdmin();

      match /expenses/{expenseId} {
        // paidBy is usually a member uid, but migrated expenses may carry a raw
        // legacy sender name instead (e.g. someone who's since left the group) —
        // only require it be a non-empty string, not necessarily a current member.
        function validPaidBy() { return request.resource.data.paidBy is string && request.resource.data.paidBy.size() > 0; }

        allow read: if canView(groupId, 'expenses');
        allow create: if canEdit(groupId, 'expenses')
          && request.resource.data.createdBy == request.auth.uid
          && validPaidBy()
          // != 0 rather than > 0: migrated corrections can be negative (e.g. a
          // later "-20" message lowering a prior entry) — only exactly-zero is
          // rejected, matching the parser's own validation.
          && request.resource.data.price is number && request.resource.data.price != 0
          // 'migrated' and 'whatsapp-bot' are only ever meant to be written by
          // trusted backends (the migration tool, the bot's Admin SDK — which
          // bypasses rules anyway); this is just a defense-in-depth backstop
          // against a client faking either source through the normal app.
          && (request.resource.data.source == 'manual' || isSiteAdmin());
        allow update: if canEdit(groupId, 'expenses') && validPaidBy();
        allow delete: if canEdit(groupId, 'expenses');
      }

      // Both part of expenses (name suggestions and merged spellings).
      match /knownNames/{nameId} {
        allow read: if canView(groupId, 'expenses');
        allow write: if canEdit(groupId, 'expenses');
      }

      match /nameAliases/{aliasId} {
        allow read: if canView(groupId, 'expenses');
        allow write: if canEdit(groupId, 'expenses');
      }

      match /migrationRuns/{runId} {
        function isGroupMember() { return isAllowed() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members; }
        allow read, write: if isGroupMember() && isSiteAdmin();
      }

      // Kept separate from the `members` map specifically so this rule can
      // scope "only your own doc" without needing to diff one nested key
      // inside a field shared with role/expectedPct/etc.
      // These are expense announcements, so they follow expenses access.
      match /notificationPrefs/{uid} {
        allow read: if canView(groupId, 'expenses');
        allow write: if canView(groupId, 'expenses') && request.auth.uid == uid;
      }

      // Written only by the OCR watcher (Admin SDK, bypasses rules) — the
      // Documents tab's lightweight per-receipt summaries (no full OCR text;
      // that stays local-only) and the per-vendor aggregate counts that let
      // it list "folders" without loading every document up front.
      match /documents/{id} {
        allow read: if canView(groupId, 'photoSaving');
        allow write: if false;
      }
      match /documentVendors/{vendorSlug} {
        allow read: if canView(groupId, 'photoSaving');
        allow write: if false;
      }

      // A direct "X owes Y" balance, independent of the paid-vs-expected-share
      // math expenses use. Both parties must be current group members — a
      // debt naming someone outside the group makes no sense since settle-up
      // only ever resolves balances between members.
      match /debts/{debtId} {
        function group() { return get(/databases/$(database)/documents/groups/$(groupId)).data; }
        function validParties(data) {
          return data.creditorUid in group().members
            && data.debtorUid in group().members
            && data.creditorUid != data.debtorUid;
        }

        allow read: if canView(groupId, 'expenses');
        allow create: if canEdit(groupId, 'expenses')
          && request.resource.data.createdBy == request.auth.uid
          && validParties(request.resource.data)
          && request.resource.data.amount is number && request.resource.data.amount > 0
          // 'whatsapp-bot' is only ever meant to come from the bot's Admin SDK
          // (which bypasses rules anyway) — defense-in-depth against a client
          // faking that source through the normal app, same as expenses.
          && (request.resource.data.source == 'manual' || isSiteAdmin());
        allow update: if canEdit(groupId, 'expenses') && validParties(resource.data);
        allow delete: if canEdit(groupId, 'expenses');
      }

      // The group's "Shopping list" capability — a flat list of items, each
      // optionally tied to a restock interval (dumb/manual for now: a fixed
      // number of days set by hand, no usage-based learning). `reminderId`
      // links to a doc in the sibling /reminders subcollection below that
      // nudges the group chat when it's due again.
      match /shoppingItems/{itemId} {
        allow read: if canView(groupId, 'shoppingList');
        allow write: if canEdit(groupId, 'shoppingList');
      }

      // Group-scoped reminders — shared, any member can see/manage one, same
      // trust level as shoppingItems/knownNames above. Kept separate from the
      // top-level /reminders collection (personal ones) specifically so this
      // rule's group-membership check can use $(groupId) from the PATH —
      // see the long comment on the top-level /reminders match for why that
      // distinction actually matters here.
      match /reminders/{reminderId} {
        function isGroupMember() { return isAllowed() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members; }
        allow read, write: if isGroupMember();
      }

      // The group's "Storage" capability — units (shelving, freezer…), the
      // items in their cells, the group's own catalog of item names and
      // categories. Anyone with edit access to storage can manage all of it.
      match /storageUnits/{unitId} {
        allow read: if canView(groupId, 'storage');
        allow write: if canEdit(groupId, 'storage');
      }
      match /storageItems/{itemId} {
        allow read: if canView(groupId, 'storage');
        allow write: if canEdit(groupId, 'storage');
      }
      match /storageCatalog/{nameKey} {
        allow read: if canView(groupId, 'storage');
        allow write: if canEdit(groupId, 'storage');
      }
      match /storageCategories/{categoryId} {
        allow read: if canView(groupId, 'storage');
        allow write: if canEdit(groupId, 'storage');
      }
      // Storage → Import → From a bill asks for a bill's products to be read
      // off it; the OCR watcher (Admin SDK) does the reading and sets status
      // to 'done'/'error'. Clients can only ask (status 'pending') or leave
      // the status as it is (to note when the items were imported).
      match /receiptItemRequests/{documentId} {
        allow read: if canView(groupId, 'photoSaving');
        allow create, update: if canView(groupId, 'photoSaving') && canEdit(groupId, 'storage')
          && request.resource.data.requestedBy == request.auth.uid
          && (request.resource.data.status == 'pending'
              || (resource != null && request.resource.data.status == resource.data.status));
        allow delete: if false;
      }

      // Append-only history of item adds/moves/edits/removals: an editor can
      // only add entries in their own name, and nobody can rewrite or delete
      // one afterwards.
      match /storageEvents/{eventId} {
        allow read: if canView(groupId, 'storage');
        allow create: if canEdit(groupId, 'storage')
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at is number;
        allow update, delete: if false;
      }
    }
  }
}
